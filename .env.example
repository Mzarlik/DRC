# ==============================================================================
# CONFIGURACIÓN DE ENTORNO — ERP DIRECCIÓN DE REGISTRO CIVIL (DRC)
# ==============================================================================
APP_NAME="ERP Dirección de Registro Civil"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/DRC
APP_TIMEZONE="America/Mexico_City"

# Base de Datos Principal (Master / Escritura)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=drc_erp
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Base de Datos Réplica (Opcional - Lectura para DataTables y Reportes)
# DB_READ_HOST=127.0.0.1
# DB_READ_PORT=3306
# DB_READ_NAME=drc_erp
# DB_READ_USER=root
# DB_READ_PASS=

# Criptografía Simétrica (AES-256-CBC con IV Aleatorio)
# Generar con: php scripts/generate_keys.php
ENCRYPTION_KEY=drc_erp_secure_aes256_symmetric_key_2026

# Blind Index Key (Hash HMAC para búsquedas exactas indexadas de CURP)
# Generar con: php scripts/generate_keys.php
BLIND_INDEX_KEY=drc_erp_blind_index_hmac_secret_key_2026

# Token de seguridad para Cron Jobs y Workers CLI
CRON_SECRET=drc_erp_weekly_cron_secret_key_2026

# Caché y Sesiones (redis / memcached / file)
CACHE_DRIVER=file
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_SOCKET=/var/run/redis/redis-server.sock
REDIS_TIMEOUT=1.0
REDIS_PASSWORD=

# Binario de PHP para el worker de exportaciones (opcional)
# En Windows/XAMPP: C:\xampp\php\php.exe | En Linux: /usr/bin/php
# PHP_BIN=C:\xampp\php\php.exe
