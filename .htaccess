# ==============================================================================
# SEGURIDAD PERIMETRAL Y REGLAS DE REESCRITURA — ERP DRC
# ==============================================================================

# Deshabilitar listado de directorios
Options -Indexes

# 1. Bloquear acceso a archivos sensibles y de configuración
<FilesMatch "^(\.env.*|\.git.*|\.agents|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Bloquear volcados de base de datos, backups, logs y documentación técnica interna
<FilesMatch "\.(sql|sql\.gz|bak|old|enc|log|ini|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Bloquear acceso directo a directorios internos mediante mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(core|docs|logs|cache|scripts|\.agents)/ - [F,L,NC]
    RewriteRule ^public/(exports|reports)/.*\.xlsx$ - [F,L,NC]
</IfModule>

# 4. Cabeceras HTTP de Seguridad Perimetral
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
