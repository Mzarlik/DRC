# ==============================================================================
# SEGURIDAD PERIMETRAL Y REGLAS DE REESCRITURA — ERP DRC
# ==============================================================================

# Deshabilitar listado de directorios
Options -Indexes

# 1. Bloquear acceso a archivos sensibles y de configuración
<FilesMatch "^(\.env.*|\.git.*|\.agents|composer\.(json|lock|phar)|package(-lock)?\.json|phpunit\.xml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 1.1 Bloquear documentación técnica interna en formato Markdown
<FilesMatch "\.(md|markdown)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Bloquear volcados de base de datos, backups, logs y documentación técnica interna
<FilesMatch "\.(sql|sql\.gz|bak|old|enc|log|ini|yml|yaml|phar)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Bloquear acceso directo a directorios internos mediante mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(core|docs|logs|cache|scripts|tests|vendor|\.agents)/ - [F,L,NC]
    RewriteRule ^public/(exports|reports)/.*\.(xlsx|csv|pdf|zip)$ - [F,L,NC]

    # Redirección amigable si se omite el prefijo "modules/" (mantiene la coherencia de rutas relativas)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(ciudadanos|nacimientos|matrimonios|divorcios|defunciones|inscripciones|reconocimientos|actas_locales|foraneas|inexistencias|reportes|curp|peticion_rapida|peticiones|turnos)(.*)$ modules/$1$2 [R=302,QSA,L]

    # Respaldo para peticiones de assets desde cualquier profundidad de URL
    RewriteRule ^([^/]+)/assets/(.*)$ assets/$2 [L,NC]
    RewriteRule ^modules/([^/]+)/assets/(.*)$ assets/$2 [L,NC]
</IfModule>

# 4. Cabeceras HTTP de Seguridad Perimetral
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # CSP: la app es 100% autocontenida (assets y fuentes locales). Se permite
    # 'unsafe-inline' mientras existan scripts/estilos embebidos en las vistas.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>
